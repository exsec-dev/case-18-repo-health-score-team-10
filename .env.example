# HealthCraft – настройки сервиса
#
# Скопируйте файл в .env и впишите SOURCECRAFT_TOKEN – этого достаточно для запуска:
# рейтинг, карточки, отчеты и публичный API работают без остальных настроек.
# Остальные блоки включают вход, AI и тонкую настройку. Закомментированная строка
# показывает значение по умолчанию (где написано «например» – пример) – раскомментируйте,
# только если нужно другое.
#
# Числа – целые больше 0; пустое значение, 0 и нечисловое значение означают «по умолчанию»,
# если у переменной не сказано иное.
# Время – в миллисекундах, в скобках – то же в привычных единицах.

# --- Обязательно --------------------------------------------------------------

# Персональный токен SourceCraft: каталог, REST API, AppSec.
# Как выпустить: https://sourcecraft.dev/portal/docs/ru/sourcecraft/security/pat
SOURCECRAFT_TOKEN=

# --- Вход через Яндекс ID -----------------------------------------------------

# Ключ подписи сессий и шифрования токенов пользователей, не короче 32 символов.
# Без него вход выключен. Сгенерировать: openssl rand -hex 32
# APP_SECRET=
# OAuth-приложение Яндекс ID (https://oauth.yandex.ru). Без них вход отвечает 503.
# YA_CLIENT_ID=
# YA_CLIENT_SECRET=
# Адрес возврата после входа – тот же, что указан в OAuth-приложении.
# YA_REDIRECT_URI=http://localhost:8418/auth/ya/callback

# --- AI-обзор и проверка оценки -----------------------------------------------
# Тексты языковой модели на оценку не влияют. Без ключа модели AI недоступен.

# Провайдер модели – один: yandex (YandexGPT) или zai (z.ai). Автоматического переключения нет.
# LLM_PROVIDER=yandex
# Модель: по умолчанию yandexgpt для yandex и glm-5.3 для zai.
# MAIN_MODEL=yandexgpt
# Модель вспомогательных ролей (разделы обзора, проверка оценки); по умолчанию – MAIN_MODEL.
# SIDE_MODEL=
# YandexGPT: API-ключ сервисного аккаунта и ID каталога Yandex Cloud.
# YAGPT_API_KEY=
# YAGPT_FOLDER_ID=
# z.ai: API-ключ.
# ZAI_API_KEY=
# Для zai: другой OpenAI-совместимый адрес, например локальная Ollama.
# LLM_BASE_URL=
# Предел одного вызова модели вместе с ответом (3 мин).
# LLM_CALL_TIMEOUT_MS=180000

# 1 – сервис сам готовит обзор и проверку оценки для топа рейтинга после нового скана.
# Лимиты пользователей эти заявки не расходуют.
# AI_TOP_AUTO=0
# Размер топа.
# AI_TOP_AUTO_SIZE=10

# Лимиты AI-обзора: на человека в час, на человека в сутки (по МСК), на весь сервис в сутки.
# AI_OVERVIEW_PER_HOUR=2
# AI_OVERVIEW_PER_DAY=6
# AI_OVERVIEW_GLOBAL_PER_DAY=30
# Лимиты проверки оценки – так же.
# AI_CHECK_PER_HOUR=5
# AI_CHECK_PER_DAY=20
# AI_CHECK_GLOBAL_PER_DAY=60
# Повторный обзор того же репозитория – не раньше чем через (1 ч).
# QUEUE_SUMMARY_COOLDOWN_MS=3600000
# Одновременных заявок на обзор у одного пользователя.
# QUEUE_SUMMARY_ACTIVE_MAX=2

# Пароль снятия личных лимитов AI; выдает администратор сервиса, вводится в «Настройках».
# Не короче 20 символов, нужен APP_SECRET. Пусто – функции нет.
# AI_UNLOCK_PASSWORD=
# Общий суточный предел для всех, кто ввел пароль: обзоров и проверок.
# AI_UNLOCKED_OVERVIEW_PER_DAY=100
# AI_UNLOCKED_CHECK_PER_DAY=100

# --- Сервер -------------------------------------------------------------------
# В контейнерах PORT, DATA_DIR, PROCESS_ROLE и SCAN_MIN_FREE_MB в .env не задают: их задают
# deploy/compose.yaml и образ. DATA_DIR из .env увел бы базу с тома /data внутрь контейнера.

# PORT=8418
# Каталог базы SQLite.
# DATA_DIR=data
# Роль процесса: all – все в одном; web – сайт, API и заявки пользователей;
# rating – обход каталога, сканы рейтинга и пересчет. В контейнерах роль задает compose.
# PROCESS_ROLE=all
# Публичный адрес сервиса для кода бейджа, например https://health-craft.ru;
# по умолчанию – адрес из YA_REDIRECT_URI.
# PUBLIC_BASE_URL=https://health-craft.ru

# --- Обход каталога -----------------------------------------------------------

# Первый обход – через (5 мин) после старта. Обход ставит в очередь сканы всего каталога.
# SCHEDULER_START_DELAY_MS=300000
# Сверка каталога: новые и удаленные репозитории (1 ч).
# SCHEDULER_CATALOG_INTERVAL_MS=3600000
# Повторные сканы изменившихся репозиториев (24 ч).
# SCHEDULER_INTERVAL_MS=86400000
# true – пересканировать все репозитории, а не только изменившиеся.
# SCHEDULER_FULL_RESCAN=false
# Сколько репозиториев за сутки пересканировать после обновления сборщика фактов; 0 – не пересканировать.
# SCHEDULER_RECOLLECT_PER_WAVE=5000
# Предохранитель: максимум страниц каталога по 100 репозиториев.
# SCAN_CATALOG_MAX_PAGES=1000

# --- Бюджеты одного скана -----------------------------------------------------

# Клон: предел времени (20 мин) и размера (1,5 ГиБ).
# SCAN_CLONE_TIMEOUT_MS=1200000
# SCAN_CLONE_MAX_BYTES=1610612736
# Не уложился – повтор с историей за 13 месяцев: включен, предел времени (25 мин) и размера (2,5 ГиБ).
# SCAN_DEGRADE_ENABLED=true
# SCAN_DEGRADE_TIMEOUT_MS=1500000
# SCAN_DEGRADE_MAX_BYTES=2684354560
# Извлечение фактов из клона (25 мин).
# SCAN_EXTRACT_TIMEOUT_MS=1500000
# Свободное место перед клоном, МБ, например 4096: меньше – клон ждет. Не задано – не проверяется.
# В контейнерах задает deploy/compose.yaml (4096).
# SCAN_MIN_FREE_MB=
# Запросов к REST API на один скан и предел одного запроса (10 с).
# SCAN_BUDGET=1000
# SCAN_REST_TIMEOUT_MS=10000
# Пауза между запросами к AppSec.
# SCAN_APPSEC_MIN_INTERVAL_MS=100

# --- Очередь и лимиты пользователей -------------------------------------------

# Параллельных сканов и AI-обзоров пользователей в процессе, от 1 до 8.
# QUEUE_USER_SCAN_SLOTS=2
# QUEUE_USER_AI_SLOTS=2
# Репозиторий, скан которого шел дольше (5 мин), берет только первый слот – остальные не ждут его.
# QUEUE_HEAVY_SCAN_MS=300000
# Запусков анализа на пользователя: в час и одновременно.
# QUEUE_USER_SCANS_PER_HOUR=10
# QUEUE_USER_ACTIVE_MAX=2
# Попыток заявки до отказа.
# QUEUE_MAX_ATTEMPTS=3
# Через сколько заявка остановившегося процесса возвращается в очередь (10 мин, не меньше 1 мин).
# SCHEDULER_LEASE_MS=600000
# Сколько дней хранить завершенные заявки.
# QUEUE_RETENTION_DAYS=30
# Избранное: репозиториев на пользователя, изменений в минуту, проверок прав в минуту.
# QUEUE_FAVORITES_MAX=500
# QUEUE_FAVORITES_MUTATIONS_PER_MINUTE=30
# QUEUE_FAVORITE_CHECKS_PER_MINUTE=6
# Автоматический повторный анализ репозитория из избранного – не чаще (6 ч).
# QUEUE_FAVORITE_OWN_COOLDOWN_MS=21600000
# Запросов в минуту от вошедшего пользователя: карточек и списка своих репозиториев.
# QUEUE_CARD_PER_MINUTE=30
# QUEUE_MY_REPOS_PER_MINUTE=30
# Кэш проверки прав зрителя на CI и AppSec: ответ (15 мин), ошибка (60 с), записей.
# ACCESS_CACHE_TTL_MS=900000
# ACCESS_FAILED_TTL_MS=60000
# ACCESS_CACHE_MAX_ENTRIES=10000

# --- Адреса внешних сервисов --------------------------------------------------
# Менять не нужно: тесты подставляют сюда локальные заглушки. Только https://
# (http:// – только для localhost и 127.0.0.1).

# SOURCECRAFT_API_BASE=https://api.sourcecraft.tech
# APPSEC_API_BASE=https://appsec.sourcecraft.tech
# SOURCECRAFT_GIT_BASE=https://git.sourcecraft.dev
# YA_OAUTH_BASE=https://oauth.yandex.ru
# YA_LOGIN_BASE=https://login.yandex.ru

# --- Стенд в контейнерах ------------------------------------------------------
# Эти переменные читает deploy/compose.yaml (docker compose --env-file), а не сервис.

# Домены для HTTPS, например – сертификат Caddy выпускает сам. Не задано – только HTTP.
# SITE_ADDRESS=health-craft.ru, www.health-craft.ru
# Основной домен, например: остальные адреса переадресуются на него.
# CANONICAL_HOST=health-craft.ru
# IP машины: запрос http://IP переадресуется на основной домен. Только вместе с CANONICAL_HOST.
# STAND_IP=
# Каталог стенда (.env, data/, tmp/) и порты прокси на машине.
# HC_DIR=/srv/healthcraft
# HTTP_PORT=80
# HTTPS_PORT=443
