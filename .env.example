# SourceCraft API (обязателен: без токена API отдаёт 401 на всё)
SOURCECRAFT_TOKEN=

# LLM: провайдер и роли (yandex — основной, zai — бэкап)
LLM_PROVIDER=yandex
MAIN_MODEL=yandexgpt
# SIDE_MODEL= (пусто = MAIN; сайд-роли: AI-summary/рекомендации)
YAGPT_API_KEY=
YAGPT_FOLDER_ID=
# ZAI_API_KEY=

# Сервер
# PORT=8418
# DATA_DIR=data
# APP_SECRET — ключ подписи сессий и шифрования PAT, ≥ 32 символов (без него вход и PAT выключены)
APP_SECRET=
# PROCESS_ROLE=all                  # роль процесса: all — для разработки (сервер + обе полосы очереди);
#                                   # web + rating — режим масштабирования, замер конкуренции записи SQLite — В6

# Вход через Яндекс ID (OAuth-приложение; без них /auth/ya отвечает 503)
# YA_CLIENT_ID=
# YA_CLIENT_SECRET=
# YA_REDIRECT_URI=http://localhost:8418/auth/ya/callback

# Адреса внешних API (В4.1-fix; дефолты — боевые; тесты направляют на локальный мок)
# SOURCECRAFT_API_BASE=https://api.sourcecraft.tech
# APPSEC_API_BASE=https://appsec.sourcecraft.tech
# SOURCECRAFT_GIT_BASE=https://git.sourcecraft.dev

# Планировщик обхода каталога
# SCHEDULER_INTERVAL_MS=86400000    # интервал обхода каталога (сутки)
# SCHEDULER_FULL_RESCAN=false       # true — ставить в очередь все репо, игнорируя дифф last_updated
# SCHEDULER_START_DELAY_MS=300000   # задержка первого обхода после старта (5 мин)

# Бюджеты скана (Config.scan; дефолты — в src/config.ts, слоями:
# дефолты ← этот env; пользовательских бюджетов нет — К5 В4.1)
# SCAN_CLONE_TIMEOUT_MS=600000      # таймаут полного клона (10 мин)
# SCAN_CLONE_MAX_BYTES=524288000    # диск-бюджет полного клона (500МБ)
# SCAN_DEGRADE_TIMEOUT_MS=1200000   # таймаут деградации shallow-13мес (20 мин)
# SCAN_DEGRADE_MAX_BYTES=2097152000 # диск-бюджет деградации (2000МБ)
# SCAN_BUDGET=1000                  # живые REST-запросы на скан
# SCAN_REST_TIMEOUT_MS=10000        # таймаут одного REST-запроса (истёк → сбой канала)
# SCAN_APPSEC_MIN_INTERVAL_MS=100   # интервал между запросами AppSec
# SCAN_CATALOG_MAX_PAGES=100        # потолок страниц каталога (20 репо/стр)

# Очередь и доступ (В4.1; дефолты — в src/config.ts)
# SCHEDULER_LEASE_MS=3600000        # лиз job (дефолт = клон + деградация + 15 мин); воркер продлевает каждые 1/3
# QUEUE_USER_SCANS_PER_HOUR=10      # новых запусков анализа на юзера за скользящий час (дальше 429)
# QUEUE_MAX_ATTEMPTS=3              # попыток job до failed
# QUEUE_USER_ACTIVE_MAX=2           # активных (в очереди/в работе) запусков анализа на юзера (дальше 429)
# ACCESS_CACHE_TTL_MS=900000        # кэш проверок доступа зрителя к CI/Security (15 мин)
# ACCESS_FAILED_TTL_MS=60000        # кэш сбоя проверки доступа (60 с)
# ACCESS_CACHE_MAX_ENTRIES=10000    # предел записей кэша доступа (вытеснение старейших)
