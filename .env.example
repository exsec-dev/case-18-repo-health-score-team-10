# SourceCraft API (обязателен: без токена API отдаёт 401 на всё)
SOURCECRAFT_TOKEN=

# LLM: провайдер и роли (yandex — основной, zai — бэкап)
LLM_PROVIDER=yandex
MAIN_MODEL=yandexgpt
# SIDE_MODEL= (пусто = MAIN; сайд-роли: AI-summary/рекомендации)
YAGPT_API_KEY=
YAGPT_FOLDER_ID=
# ZAI_API_KEY=

# Сервер
# PORT=8418
# DATA_DIR=data
APP_SECRET=

# Бюджеты скана (Config.scan; дефолты — в src/config.ts, слоями:
# дефолты ← этот env; пользовательских бюджетов нет — К5 В4.1)
# SCAN_CLONE_TIMEOUT_MS=600000      # таймаут полного клона (10 мин)
# SCAN_CLONE_MAX_BYTES=524288000    # диск-бюджет полного клона (500МБ)
# SCAN_DEGRADE_TIMEOUT_MS=1200000   # таймаут деградации shallow-13мес (20 мин)
# SCAN_DEGRADE_MAX_BYTES=2097152000 # диск-бюджет деградации (2000МБ)
# SCAN_BUDGET=1000                  # живые REST-запросы на скан
# SCAN_CATALOG_MAX_PAGES=100        # потолок страниц каталога (20 репо/стр)

# Очередь и доступ (В4.1; дефолты — в src/config.ts)
# SCHEDULER_LEASE_MS=3600000        # лиз job (дефолт = клон + деградация + 15 мин); воркер продлевает каждые 1/3
# QUEUE_USER_SCANS_PER_HOUR=10      # новых запусков анализа на юзера за скользящий час (дальше 429)
# QUEUE_MAX_ATTEMPTS=3              # попыток job до failed
# ACCESS_CACHE_TTL_MS=900000        # кэш проверок доступа зрителя к CI/Security (15 мин)
